# Copy to .env.local and fill in. Never commit real values.

# Sender account (sends the newsletter sign-up notifications).
# For Gmail, use an App Password (Google Account → Security → App passwords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Receiver: every newsletter sign-up is delivered here
CONTACT_TO_EMAIL=inbox@example.com
