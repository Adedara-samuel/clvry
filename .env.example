# Copy to .env.local and fill in. Never commit real values.

# Sender account (sends sign-up notifications and campaigns; the admin also reads it over IMAP).
# For Gmail, use an App Password (Google Account → Security → App passwords), not the account password,
# and make sure IMAP is enabled (Gmail → Settings → Forwarding and POP/IMAP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Receiver: every newsletter sign-up is delivered here
CONTACT_TO_EMAIL=inbox@example.com

# ── Admin portal (/admin) ─────────────────────────────────────────────
ADMIN_USERNAME=admin
# Use something long. Anyone with this can email your whole list.
ADMIN_PASSWORD=change-me
# Signs the login cookie and unsubscribe links. 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out and breaks unsubscribe links in emails already sent.
ADMIN_SESSION_SECRET=

# Public address of the site, used in email links (defaults to wherever the admin is opened).
SITE_URL=https://clvry.example.com

# Saving content from the live site: each save is a commit to this repo, and the host redeploys.
# Fine-grained token with "Contents: Read and write" on this repo only.
# Leave unset locally: in `npm run dev` saves go straight to src/content instead.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# Optional: only if your mail provider's IMAP host isn't SMTP_HOST with smtp. → imap.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
